# ВАЖНО: комментарии пишите только на отдельной строке, не после значения.

# ===== Discord =====
DISCORD_TOKEN=your_discord_bot_token
# id сервера для мгновенной синхронизации команд (необязательно)
TEST_GUILD_ID=
ADMIN_ROLE_NAME=VPN Admin
# роль Boosty: есть роль -> VPN работает
VPN_ROLE_NAME=VPN Access
# роль пробного периода (один раз на человека)
TRIAL_ROLE_NAME=VPN Trial
TRIAL_DAYS=10
DEVICE_LIMIT=3
# Страница Boosty - ссылка в напоминаниях о конце пробного периода
BOOSTY_URL=

# Снимать роль VPN Trial после окончания пробного периода
# (роль бота должна быть выше VPN Trial и иметь право «Управление ролями»)
REMOVE_TRIAL_ROLE_ON_EXPIRY=true
# Как часто сверять роли всех участников с подписками, минут (0 - только при запуске)
SYNC_INTERVAL_MINUTES=30

# ===== Основной сервер 3x-ui =====
# Название сервера в /status_server и /myvpn
XUI_NAME=Хельсинки
XUI_BASE_URL=https://your-domain:port
# Секретный путь панели (то, что после порта в адресе панели), без слешей
XUI_WEB_BASE_PATH=
# Адрес подписок этого сервера (то, что идёт перед subId в ссылке подписки)
XUI_SUB_BASE=https://your-domain:2096/sub
XUI_VERIFY_SSL=true
# API-токен: Настройки → Безопасность → API Token (scope admin).
# Задан - бот работает через API (быстро, без браузера, нужен для доп. серверов,
# перевыпуска ссылок и /ips). Пусто - старый режим через браузер (логин и пароль ниже).
XUI_API_TOKEN=
# Inbound'ы для новых клиентов в режиме API: all или номера через запятую (например 1,3)
XUI_INBOUND_IDS=all
# Только для режима браузера:
XUI_USERNAME=admin
XUI_PASSWORD=change_me
XUI_INBOUND_ID=1
XUI_STATIC_CSRF_TOKEN=

# ===== Второй сервер (необязательно, только через API-токен) =====
# Бот сам создаёт клиента и на нём и добавляет его подписку как внешнюю
# в подписку основного сервера - у пользователя одна ссылка на обе локации.
# Третий сервер - те же строки с XUI3_, и так до XUI5_.
XUI2_NAME=Милан
XUI2_BASE_URL=
XUI2_WEB_BASE_PATH=
XUI2_SUB_BASE=
XUI2_API_TOKEN=
XUI2_VERIFY_SSL=true
XUI2_INBOUND_IDS=all

# ===== Проверка доступности из РФ (/status_server) =====
# Через узлы check-host.net в России проверяется TCP-подключение к серверу.
# По умолчанию - к хосту и порту из XUI_SUB_BASE; свой адрес: XUI_CHECK_TARGET=host:port
RF_CHECK=true
XUI_CHECK_TARGET=
XUI2_CHECK_TARGET=

# ===== Happ (оставьте пустым, если не используете) =====
HAPP_PROVIDER_ID=

# ===== Кнопка «Добавить в Nexus» =====
# Бот поднимает маленькую https-страницу, которая открывает приложение по nexus://.
# Публичный адрес: домен этого VPS и свободный порт (откройте его в фаерволе).
# Пусто - кнопки нет.
NEXUS_LINK_BASE=
NEXUS_LINK_PORT=8444
# Сертификат и ключ домена - те же файлы, что у панели 3x-ui
# (Настройки панели → Сертификаты: «Путь к файлу публичного ключа» и «приватного ключа»)
NEXUS_LINK_CERT=
NEXUS_LINK_KEY=
# Где скачать Nexus (страница релизов) - кнопка «Скачать Nexus», необязательно
NEXUS_DOWNLOAD_URL=

# ===== Поддержка =====
# id текстового канала, в котором /support создаёт приватные ветки
SUPPORT_CHANNEL_ID=

# ===== Контроль «шаринга» (только режим API) =====
# Оповещать админов, если с подписки за сутки подключались с большего числа разных IP
SHARING_CHECK=true
SHARING_IP_THRESHOLD=5
# Не чаще одного перевыпуска ссылки за это время на человека, секунд
REISSUE_COOLDOWN_SEC=600

# ===== Вебхуки =====
# Канал, куда /status_server публикует карточку статуса
STATUS_WEBHOOK_URL=
STATUS_COOLDOWN_SEC=30
# Закрытый канал админов: ошибки, итоги сверки, падение Xray, блокировки, шаринг, обращения
ADMIN_LOG_WEBHOOK_URL=

# ===== Лог =====
# bot.log с автоматической ротацией: до LOG_MAX_MB МБ, LOG_BACKUPS старых копий
LOG_FILE=bot.log
LOG_MAX_MB=5
LOG_BACKUPS=3
